# Append to /etc/caddy/Caddyfile next to paper's block, then: sudo systemctl reload caddy
# Build locally (npm run build), then copy out/ to the server:
#   rsync -a --delete site/out/ server:/srv/alhadad-site/
alhadad.dev {
	encode zstd gzip
	# Next's build files are content-hashed, so they never change; everything else revalidates by ETag.
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
	# No preload on HSTS yet: the preload list is slow to leave.
	# shortcut: script-src allows 'unsafe-inline' because Next's export writes per-build inline flight scripts; move to build-time hashes if the site ever takes user input.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	root * /srv/alhadad-site
	try_files {path} {path}.html
	file_server
	# Unknown paths get Next's 404 page with a real 404 status, not the home page.
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.alhadad.dev {
	redir https://alhadad.dev{uri} permanent
}
